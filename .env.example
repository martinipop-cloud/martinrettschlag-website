# ---------------------------------------------------------------------------
# Vorlage für die Umgebungsvariablen.
# Zum Arbeiten diese Datei nach ".env.local" kopieren und die Werte eintragen.
# ".env.local" wird bewusst NICHT in Git eingecheckt (enthält Zugangsdaten).
# ---------------------------------------------------------------------------

# --- Sanity (CMS) ----------------------------------------------------------
# Zu finden unter https://www.sanity.io/manage -> Projekt -> Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Name des Datensatzes. Standard ist "production".
NEXT_PUBLIC_SANITY_DATASET=production
# Datumsstand der Sanity-Schnittstelle. Nur ändern, wenn es einen Grund gibt.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-15

# Adresse, unter der die Website erreichbar ist. Wird für die Sitemap, die
# robots.txt und die Links in den E-Mails gebraucht. Lokal:
# http://localhost:3000 — auf Vercel: https://www.martinrettschlag.de
NEXT_PUBLIC_SITE_URL=

# Schreibzugriff für den Download-Zähler (F-410).
# Erzeugen unter https://www.sanity.io/manage -> Projekt -> API -> Tokens
# Berechtigung: "Editor". NIEMALS mit NEXT_PUBLIC_ beginnen lassen –
# dieser Wert darf ausschliesslich serverseitig verwendet werden.
SANITY_API_WRITE_TOKEN=

# Lese-Token für die Website. Zwingend nötig, sobald der Datensatz bei Sanity
# auf "privat" gestellt ist. Berechtigung: "Viewer".
SANITY_API_READ_TOKEN=

# --- Newsletter über Brevo (Kapitel 4.9) -----------------------------------
# Der Schlüssel steht in Brevo unter "SMTP & API" -> "API-Schlüssel".
# Berechtigungen: Kontakte (alle), Transaktions-E-Mails (senden),
# E-Mail-Kampagnen (keine). Niemals mit NEXT_PUBLIC_ – ein öffentlicher
# Schlüssel erlaubt Fremden, die Empfängerliste zu lesen und zu löschen.
BREVO_API_KEY=
# Kennziffer der Empfängerliste ("Newsletter" im Ordner "Website").
BREVO_LIST_ID=
# Kennziffern der beiden Vorlagen für die Anmeldebestätigung.
BREVO_DOI_TEMPLATE_ID_DE=
BREVO_DOI_TEMPLATE_ID_EN=
# Absender der direkten Download-Mail an bereits Angemeldete. Muss in Brevo
# unter "Senders & Domains" bestätigt sein, sonst lehnt Brevo den Versand ab.
BREVO_SENDER_EMAIL=newsletter@martinrettschlag.de
# Antwortadresse der direkten Download-Mail. Leer = support@martinrettschlag.de.
# Die Bestätigungsmails tragen ihre Antwortadresse in der Vorlage bei Brevo.
BREVO_REPLY_TO=

# Unterschreibt die Download-Links hinter der Anmeldung (F-404n). Beliebige
# Zufallsfolge, mindestens 32 Zeichen. Erzeugen zum Beispiel mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wird der Wert ausgetauscht, laufen alle verschickten Links sofort ab.
NEWSLETTER_SECRET=

# --- Tool-Dateien über GitHub (F-413, F-414) --------------------------------
# Liest die Releases der privaten Tool-Repositories. Ohne Token sind
# private Repos unsichtbar, und die Software-Seite fällt auf die Datei in
# Sanity zurück (oder zeigt keinen Download).
# Erzeugen unter https://github.com/settings/personal-access-tokens
# -> "Fine-grained token", Repository access: nur die Tool-Repos,
# Permissions -> Repository -> Contents: "Read-only". Sonst nichts.
# Ablaufdatum setzen und im Kalender vormerken — ein abgelaufenes Token
# meldet sich nur im Vercel-Log ("HTTP 401").
GITHUB_TOKEN=
