# ---------------------------------------------------------------------------
# Vorlage für die Umgebungsvariablen.
# Zum Arbeiten diese Datei nach ".env.local" kopieren und die Werte eintragen.
# ".env.local" wird bewusst NICHT in Git eingecheckt (enthält Zugangsdaten).
# ---------------------------------------------------------------------------

# --- Sanity (CMS) ----------------------------------------------------------
# Zu finden unter https://www.sanity.io/manage -> Projekt -> Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Name des Datensatzes. Standard ist "production".
NEXT_PUBLIC_SANITY_DATASET=production
# Datumsstand der Sanity-Schnittstelle. Nur ändern, wenn es einen Grund gibt.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-15

# Schreibzugriff für das Kontaktformular (F-605: Anfragen im CMS speichern).
# Erzeugen unter https://www.sanity.io/manage -> Projekt -> API -> Tokens
# Berechtigung: "Editor". NIEMALS mit NEXT_PUBLIC_ beginnen lassen –
# dieser Wert darf ausschliesslich serverseitig verwendet werden.
SANITY_API_WRITE_TOKEN=

# Lese-Token für die Website. Zwingend nötig, sobald der Datensatz bei Sanity
# auf "privat" gestellt ist – und das MUSS er sein, sobald Kontaktanfragen
# gespeichert werden, sonst sind sie öffentlich abrufbar.
# Berechtigung: "Viewer".
SANITY_API_READ_TOKEN=

# --- Mailversand über das All-Inkl-Postfach (F-604) ------------------------
# Alle Werte stehen im All-Inkl-Kundenmenü (KAS) unter "E-Mail" beim
# jeweiligen Postfach, Abschnitt "Zugangsdaten".
#
# Postausgangsserver, sieht aus wie w01abcde.kasserver.com
SMTP_HOST=
# 587 für STARTTLS (empfohlen) oder 465 für SSL
SMTP_PORT=587
# Postfach-Benutzername aus dem KAS (oft in der Form m01abcde)
SMTP_USER=
# Passwort des Postfachs
SMTP_PASSWORD=
# Absenderadresse, die im Postfach angezeigt wird
SMTP_FROM=hello@martinrettschlag.de
# Empfänger der Formularanfragen
CONTACT_TO=hello@martinrettschlag.de
